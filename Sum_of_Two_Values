#include<bits/stdc++.h>
using namespace std;

map<int,int> mp;//first is value  second is position
  
int main(){
  ios::sync_with_stdio(0); cin.tie(0);
  int n,s,c=0;
  cin>>n>>s;
  vector<int> v(n);
  int k=1;
  for(auto &e:v){
    cin>>e;
    mp[e]=k;
    k++;
  }
  for(int i=0;i<v.size();i++){
    if(mp.count(s-v[i]) > 0 && (i+1 != mp[s-v[i]]) ){// mp[s-v[i]]>0
      cout<<i+1<<" "<<mp[s-v[i]];
      return 0;
    }
  }
  cout<<"IMPOSSIBLE";
}
